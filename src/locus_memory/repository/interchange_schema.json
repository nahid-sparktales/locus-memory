{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://locus.local/schemas/locus-memory.repository-interchange/1",
  "title": "locus-memory repository interchange, version 1",
  "description": "Portable repository inventory and observations. The authoritative validator is locus_memory.repository.interchange.validate_document (strict, stdlib-only); it additionally enforces a 16 MiB document budget, at most 100000 records, hash length matching hash_algorithm, safe relative paths and the exclusion list (secret-bearing paths are rejected). Summaries are model output and are only ever imported as unapproved candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "producer", "repository_id", "hash_algorithm", "records"],
  "properties": {
    "format": {"const": "locus-memory.repository-interchange"},
    "version": {"const": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "kind": {"enum": ["observer", "tool", "model"]},
        "models": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "repository_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "hash_algorithm": {"enum": ["sha1", "sha256"]},
    "generated_at": {"type": "number", "minimum": 0, "maximum": 32503680000},
    "since_snapshot": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "records": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/repository"},
          {"$ref": "#/$defs/snapshot"},
          {"$ref": "#/$defs/file"},
          {"$ref": "#/$defs/symbol"},
          {"$ref": "#/$defs/import"},
          {"$ref": "#/$defs/observation"},
          {"$ref": "#/$defs/summary"}
        ]
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Repository-relative, '/'-separated; no empty, '.' or '..' components, no leading '/', no backslash, no control characters; never an excluded path.",
      "not": {"pattern": "(^/)|(\\\\)|(^|/)\\.{1,2}(/|$)|//|(/$)|[\\u0000-\\u001f\\u007f]"}
    },
    "extraction": {"enum": ["ast", "heuristic", "tool"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository_id", "object_format"],
      "properties": {
        "type": {"const": "repository"},
        "repository_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
        "object_format": {"enum": ["sha1", "sha256"]},
        "initial_commit": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "snapshot_id", "state"],
      "properties": {
        "type": {"const": "snapshot"},
        "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
        "state": {"enum": ["complete", "partial"]},
        "head": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "dirty": {"type": "boolean"},
        "created_at": {"type": ["number", "null"]}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "blob"],
      "properties": {
        "type": {"const": "file"},
        "path": {"$ref": "#/$defs/path"},
        "blob": {"$ref": "#/$defs/hash"},
        "size": {"type": ["integer", "null"], "minimum": 0},
        "language": {"type": "string", "minLength": 1, "maxLength": 64},
        "support": {"enum": ["parsed", "heuristic", "unsupported"]}
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "blob", "name", "symbol_kind"],
      "properties": {
        "type": {"const": "symbol"},
        "path": {"$ref": "#/$defs/path"},
        "blob": {"$ref": "#/$defs/hash"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "symbol_kind": {"enum": ["class", "function", "async_function"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "extraction": {"$ref": "#/$defs/extraction"}
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "blob", "module"],
      "properties": {
        "type": {"const": "import"},
        "path": {"$ref": "#/$defs/path"},
        "blob": {"$ref": "#/$defs/hash"},
        "module": {"type": "string", "minLength": 1, "maxLength": 300},
        "names": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "extraction": {"$ref": "#/$defs/extraction"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "blob", "text"],
      "properties": {
        "type": {"const": "observation"},
        "path": {"$ref": "#/$defs/path"},
        "blob": {"$ref": "#/$defs/hash"},
        "text": {"type": "string", "minLength": 1, "maxLength": 32000},
        "extraction": {"$ref": "#/$defs/extraction"},
        "language": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "source_hashes", "producer", "model", "basis"],
      "description": "Model output. Imported as an unapproved candidate with basis model_interpretation; never approved by import.",
      "properties": {
        "type": {"const": "summary"},
        "text": {"type": "string", "minLength": 1, "maxLength": 32000},
        "title": {"type": "string", "maxLength": 160},
        "source_hashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [{"$ref": "#/$defs/path"}, {"$ref": "#/$defs/hash"}]
          }
        },
        "producer": {"type": "string", "minLength": 1, "maxLength": 128},
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "basis": {"const": "model_interpretation"}
      }
    }
  }
}
